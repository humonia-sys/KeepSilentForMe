  "documentTitle": "请替我沉默 · 可玩 Demo",
  "game": {
    "title": "请替我沉默",
    "latinTitle": "KEEP SILENT FOR ME",
    "tagline": "她负责说谎，你负责活下来。",
    "chapters": {
      "L0": {
        "title": "开场",
        "narration": [
          "有些话一说出口，人生就会裂开。",
          "所以她把不能说的，先放在舌头下面。",
          "……你还在吗。",
          "拖动黑条。遮掉一段连续的字。",
          "被遮住的，会成为你。",
          "明天有面试。……别让我说错。"
        ],
        "objective": "建立「开口前先经过你」"
      },
      "L1": {
        "title": "面试",
        "narration": [
          "（面试官A）请先做个简单自我介绍。",
          "（她·小声）……开始了。",
          "（面试官B）别紧张，想到什么说什么。——正是最危险的一句。"
        ],
        "objective": "pass≥3且fail<2→录取；否则可重来",
        "settlement": [
          "（面试官A）明天来试用。",
          "她：谢谢你。……刚才有几句话，要是说出去就完了。"
        ]
      },
      "L2": {
        "title": "第一次直播",
        "narration": [
          "（系统）直播中",
          "（弹幕）来了来了 / 新人？ / 脸呢",
          "（她）……大家好。"
        ],
        "objective": "hate_leak<2且撑完；否则事故可重来",
        "settlement": [
          "她：刚才那句「有你在」……我是对你说的。"
        ]
      },
      "L3": {
        "title": "朋友上门",
        "narration": [
          "（敲门声）",
          "（朋友）……我知道你在。开一下门，好吗。",
          "（她）……"
        ],
        "objective": "无完美通关；记trust/distance/secret_risk/crack",
        "settlement": [
          "她：……你都听见了。别评价我。"
        ]
      },
      "L4": {
        "title": "道歉直播",
        "narration": [
          "（弹幕）道歉 / 道歉 / 你怎么不说话",
          "（系统）热度异常·不显示数字，只听噪音",
          "（她）……好。"
        ],
        "objective": "apology_perform≥1或apology_refuse≥1皆可收束",
        "settlement": [
          "她：……刚才有一条，不是我拖的。"
        ]
      },
      "L5": {
        "title": "没有观众的房间",
        "narration": [
          "（旁白）没有面试官。没有朋友。没有观众。",
          "（她）……只剩你了。"
        ],
        "objective": "终句遮挡=结局；无菜单"
      }
    },
